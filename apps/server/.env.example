# apps/server — validated at startup (apps/server/src/config/env.ts)
NODE_ENV=development
PORT=3000
# Comma-separated allowlist. Empty = CORS disabled (native apps do not need it).
CORS_ORIGINS=

# Table (Modo Mesa) settings. Defaults shown.
# Blinds; small must be lower than big.
TABLE_SMALL_BLIND=10
TABLE_BIG_BLIND=20
# Buy-in range in chips; min must not exceed max.
TABLE_MIN_BUY_IN=400
TABLE_MAX_BUY_IN=2000
# Seats per table, 2 to 6.
TABLE_MAX_SEATS=6
# Seats the server tries to keep filled (humans + bots); must not exceed TABLE_MAX_SEATS.
TABLE_BOT_FILL_TARGET=4
# Time a player has to act before auto check/fold.
TURN_TIMEOUT_MS=20000
# Grace period after a socket disconnect before the player is auto-played.
DISCONNECT_GRACE_MS=45000
# Max time sitting out before the seat is released.
SITTING_OUT_MAX_MS=300000
# Pause between the end of a hand and the next deal.
BETWEEN_HANDS_MS=3000
# Time an empty table lives before it is closed.
EMPTY_TABLE_CLOSE_MS=60000
# Chips given to each new user in the in-memory dev wallet.
DEV_WALLET_INITIAL=10000
# Max socket messages per second per connection.
SOCKET_RATE_LIMIT_PER_SEC=10
# Simulated bot "thinking" time range (min must not exceed max).
BOT_DELAY_MIN_MS=800
BOT_DELAY_MAX_MS=2500

# Phase 3 (ADR 0005), not used yet:
# DATABASE_URL=        # Supabase pooled connection (app)
# DIRECT_URL=          # Supabase direct connection (migrations)
# SUPABASE_URL=
# SUPABASE_JWT_SECRET= # or JWKS URL, to verify access tokens
