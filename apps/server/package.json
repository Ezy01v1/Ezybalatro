{
  "name": "@naipes/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "prisma generate && nest start --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint src test",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && node --experimental-vm-modules ./node_modules/jest/bin/jest.js && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.int.config.js && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.js",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:int": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.int.config.js",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.js",
    "db:migrate:dev": "nest build && node dist/src/db/migrate-dev.js",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@naipes/engine": "workspace:*",
    "@naipes/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14"
  }
}
